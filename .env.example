# ─── MongoDB Atlas (Required) ───
# Get your free cluster: https://www.mongodb.com/atlas
AI_MEMORY_MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ─── Google Gemini API (Optional — for Vector Search + RAG) ───
# Get your key: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here
# OR
GEMINI_API_KEY=your_gemini_api_key_here

# ─── MCP Server API Key (Optional — for HTTP mode auth) ───
AI_MEMORY_API_KEY=your_secret_api_key_here
